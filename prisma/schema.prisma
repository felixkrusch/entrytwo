generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum EventType {
  JOURNAL_ENTRY_CREATED
  JOURNAL_ENTRY_REVERSED
  ACCOUNT_CREATED
  CONTACT_CREATED
  INVOICE_CREATED
  INVOICE_SENT
  INVOICE_PAID
  AI_ACTION_EXECUTED
  MANUAL_ADJUSTMENT
  SYSTEM
  USER_CREATED
  // Git Model for Accounting events (see docs/Git-Model-for-Accounting.md and docs/Git-Model-Implementation-Plan.md)
  BRANCH_CREATED
  MERGE
  TAG_CREATED
  ROLLBACK
  RECONCILIATION_RUN
  AI_AUTONOMOUS_ENTRY
  JOURNAL_ATTACHMENT_ADDED
}

enum Role {
  ADMIN
  ACCOUNTANT
  VIEWER
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
}

enum JobStatus {
  PENDING
  RUNNING
  RETRY
  SUCCEEDED
  DEAD_LETTER
}

enum WebhookProcessingStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum ExpenseClaimWorkflowStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ExpenseClaimPostingStatus {
  UNPOSTED
  POSTED
  REVERSED
}

enum ExpenseClaimReimbursementStatus {
  NOT_READY
  READY
  PARTIALLY_REIMBURSED
  REIMBURSED
}

enum ExpenseClaimPaymentMethod {
  PERSONAL_FUNDS
  COMPANY_CARD
  CASH_ADVANCE
  OTHER
}

enum ExpenseClaimDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model User {
  id                    String                      @id @default(uuid())
  email                 String                      @unique
  emailVerified         DateTime?
  name                  String?
  image                 String?
  role                  Role                        @default(VIEWER)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  events                Event[]
  expenseClaims         ExpenseClaim[]              @relation("ExpenseClaimClaimant")
  approvedExpenseClaims ExpenseClaim[]              @relation("ExpenseClaimApprover")
  postedExpenseClaims   ExpenseClaim[]              @relation("ExpenseClaimPoster")
  claimReceipts         ExpenseClaimReceipt[]
  claimActivities       ExpenseClaimActivity[]
  claimApprovals        ExpenseClaimApproval[]
  claimReimbursements   ExpenseClaimReimbursement[]
  fileAssets            FileAsset[]
  chatThreads           ChatThread[]
  totpSecret            String? // Encrypted TOTP secret for 2FA
  totpEnabled           Boolean                     @default(false) // Whether TOTP is enabled
  totpLastUsedStep      BigInt?
  totpRecoveryCodes     TotpRecoveryCode[]
  settings              Json? // User preferences including 2FA settings
  sessionVersion        Int                         @default(0)
  disabled              Boolean                     @default(false)
  oauthAccounts         OAuthAccount[]
  invitationsCreated    UserInvitation[]            @relation("InvitationCreator")
  periodsClosed         AccountingPeriod[]          @relation("PeriodCloser")
}

// Auth.js OAuth account link (Google / Microsoft Entra ID)
model OAuthAccount {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Auth.js email magic-link tokens
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@unique([token])
  @@index([expires])
}

model UserInvitation {
  id          String    @id @default(uuid())
  email       String
  role        Role      @default(VIEWER)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  createdById String

  createdBy User @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([email, expiresAt])
}

model AccountingPeriod {
  id           String                 @id @default(uuid())
  name         String
  startDate    DateTime
  endDate      DateTime
  status       AccountingPeriodStatus @default(OPEN)
  closedAt     DateTime?
  closedById   String?
  reopenReason String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  closedBy User? @relation("PeriodCloser", fields: [closedById], references: [id], onDelete: Restrict)

  @@unique([startDate, endDate])
  @@index([status, startDate, endDate])
}

model Account {
  id                  String             @id @default(uuid())
  code                String             @unique
  name                String
  type                AccountType
  description         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  journalLines        JournalLine[]
  bankConnections     BankConnection[]
  expenseClaimLines   ExpenseClaimLine[]
  reimbursementClaims ExpenseClaim[]     @relation("ExpenseClaimReimbursementAccount")
}

model Contact {
  id                String             @id @default(uuid())
  name              String
  email             String?
  type              String // "CUSTOMER" or "VENDOR"
  phone             String? // International format, max 50 chars
  addressStreet     String? // Line 1 (street address)
  addressCity       String? // City
  addressState      String? // State/Province
  addressZip        String? // Postal/ZIP code
  addressCountry    String? // ISO 3166-1 alpha-2 country code (e.g., "DE", "US")
  addressLine2      String? // Additional address line (P.O. Box, apartment, etc.)
  taxId             String? // VAT/EIN/tax identification
  website           String? // Company website URL
  currency          String? // Preferred currency (ISO 4217), fallback to company default
  preferredLanguage String? // Optional 'en' | 'de' — used to prefill invoice language
  notes             String? // Internal notes
  vatValid          Boolean? // Whether VAT validation passed
  vatValidated      Boolean            @default(false)
  vatValidatedAt    DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  journalLines      JournalLine[]
  invoices          Invoice[]
  recurringInvoices RecurringInvoice[]
}

model JournalEntry {
  id                  String                      @id @default(uuid())
  date                DateTime
  description         String?
  entryNumber         String?                     @unique // human reference, e.g. "JE-2026-0001"
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  createdBy           String?
  // Git Model: the Event that introduced this entry into a branch's visible history
  introducedByEventId String?
  lines               JournalLine[]
  feedTransactions    FeedTransaction[]
  invoices            Invoice[]
  attachments         JournalAttachment[]
  postedExpenseClaim  ExpenseClaim?               @relation("ExpenseClaimPosting")
  claimReimbursements ExpenseClaimReimbursement[]
}

model JournalAttachment {
  id             String   @id @default(uuid())
  journalEntryId String
  fileAssetId    String
  source         String   @default("manual")
  createdAt      DateTime @default(now())
  createdBy      String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  fileAsset    FileAsset    @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@unique([journalEntryId, fileAssetId])
  @@index([journalEntryId])
  @@index([fileAssetId])
}

model FileAsset {
  id           String   @id @default(uuid())
  storageKey   String   @unique
  storage      String   @default("local")
  originalName String
  mimeType     String
  size         Int
  sha256       String
  createdById  String
  createdAt    DateTime @default(now())

  createdBy     User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  journals      JournalAttachment[]
  claimReceipts ExpenseClaimReceipt[]
  chatMessages  ChatMessageAttachment[]

  @@index([sha256])
  @@index([createdById, createdAt])
}

model ChatThread {
  id         String    @id @default(uuid())
  userId     String
  title      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  expiresAt  DateTime?
  archivedAt DateTime?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@index([expiresAt])
}

model ChatMessage {
  id             String   @id @default(uuid())
  threadId       String
  role           String
  content        String
  action         String?
  metadata       Json?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  thread      ChatThread              @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments ChatMessageAttachment[]

  @@index([threadId, createdAt, id])
}

model ChatMessageAttachment {
  messageId   String
  fileAssetId String

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileAsset FileAsset   @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@id([messageId, fileAssetId])
  @@index([fileAssetId])
}

model JournalLine {
  id             String    @id @default(uuid())
  journalEntryId String
  accountId      String
  contactId      String?
  debit          Decimal   @default(0)
  credit         Decimal   @default(0)
  description    String?
  taxRateId      String?
  taxIsInput     Boolean? // explicit input/output for this tax application (null = derive)
  currency       String    @default("EUR") // ISO 4217 currency code
  fxRateToBase   Decimal? // exchange rate to system base currency at entry time
  fxSource       String? // e.g. "ECB", "manual"
  fxDate         DateTime? // date the fx rate applies to
  cleared        Boolean   @default(false) // reconciliation / bank-cleared status for this line

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])
  contact      Contact?     @relation(fields: [contactId], references: [id])
  taxRate      TaxRate?     @relation(fields: [taxRateId], references: [id])
}

model TaxRate {
  id            String    @id @default(uuid())
  jurisdiction  String // e.g. "DE", "US-CA", "EU", "AT"
  name          String // e.g. "MwSt 19%", "USt 7%", "Sales Tax 8.25%"
  rate          Decimal // e.g. 0.19 for 19%
  taxType       String // "STANDARD" | "REDUCED" | "EXEMPT" | "ZERO" | "REVERSE_CHARGE"
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  journalLines      JournalLine[] // back-relation for tax on lines
  invoiceLines      InvoiceLine[] // back-relation for invoice tax
  expenseClaimLines ExpenseClaimLine[]

  // Optional: link to dedicated tax accounts in the future
  // inputTaxAccountId  String?
  // outputTaxAccountId String?
}

model Event {
  id             String    @id @default(uuid())
  idempotencyKey String?   @unique
  eventType      EventType
  entityType     String
  entityId       String
  payload        Json
  metadata       Json?
  createdAt      DateTime  @default(now())
  createdBy      String?
  // Git ancestry: parent points to previous head for linear history + restore jumps
  parentEventId  String?
  parent         Event?    @relation("EventParent", fields: [parentEventId], references: [id])
  children       Event[]   @relation("EventParent")
  user           User?     @relation(fields: [createdBy], references: [id])
}

model DurableJob {
  id             String       @id @default(uuid())
  type           String
  idempotencyKey String       @unique
  payload        Json
  status         JobStatus    @default(PENDING)
  attempts       Int          @default(0)
  maxAttempts    Int          @default(5)
  availableAt    DateTime     @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  attemptHistory JobAttempt[]

  @@index([status, availableAt])
  @@index([lockedAt])
}

model JobAttempt {
  id         String     @id @default(uuid())
  jobId      String
  attempt    Int
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  error      String?
  workerId   String
  job        DurableJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, startedAt])
}

model WebhookEvent {
  id          String                  @id @default(uuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  status      WebhookProcessingStatus @default(PENDING)
  attempts    Int                     @default(0)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([provider, externalId])
  @@index([status, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model Snapshot {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  data        Json
  // Git Model: the event up to which this snapshot is valid (for replay)
  upToEventId String?
}

// Git Model for Accounting: lightweight branches for main, AI proposals, experiments
// See docs/Git-Model-for-Accounting.md and docs/Git-Model-Implementation-Plan.md
model AccountingBranch {
  id             String   @id @default(uuid())
  name           String   @unique // "main", "ai-june-recon", etc.
  description    String?
  headEventId    String? // points to the latest Event that is the head of this branch
  headSnapshotId String? // optional: snapshot for fast restore
  isMain         Boolean  @default(false)
  createdAt      DateTime @default(now())
  createdBy      String?
  updatedAt      DateTime @updatedAt
}

// Global settings / company configuration (used by Admin UI)
model Setting {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "company.name", "baseCurrency", "defaultTaxJurisdiction"
  value     Json // flexible value (string, number, object, etc.)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Transaction templates for recurring entries + invoice templates
model Template {
  id                String   @id @default(uuid())
  name              String
  description       String?
  content           String? // Template definition (JSON structure)
  isInvoiceTemplate Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Recurring invoice schedules
// Philosophy (per docs + best practice):
// - By default: generates DRAFT invoices on schedule.
// - User reviews/approves/edits and then sends (Stripe/PayPal/Email).
// - Optional per-schedule: autoSend (still creates draft + attempts send after generation for auditability).
model RecurringInvoice {
  id              String    @id @default(uuid())
  name            String // e.g. "ACME monthly retainer"
  contactId       String
  frequency       String // WEEKLY | MONTHLY | QUARTERLY | YEARLY
  interval        Int       @default(1) // e.g. every 1 month, every 3 months
  startDate       DateTime
  endDate         DateTime?
  nextDueDate     DateTime
  lastGeneratedAt DateTime?
  autoSend        Boolean   @default(false) // if true, after generating draft, try to send via default method
  status          String    @default("ACTIVE") // ACTIVE | PAUSED | CANCELLED
  notes           String?
  // Snapshot of what to bill (lines, currency, terms, notes)
  // Stored as JSON for simplicity and to survive template changes
  templateData    Json // { currency, lines: [...], notes?, terms?, taxRates? }
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  contact Contact @relation(fields: [contactId], references: [id])
}

// Recurring journal-entry schedules (the "Repeat on a schedule" feature).
// Mirrors RecurringInvoice but for double-entry journal lines.
// Philosophy: generates DRAFT-ready journal entries on schedule; the user can
// review before they post (or auto-post for convenience). Each generated entry
// is a normal JournalEntry so it appears in the ledger/journal like any other.
model RecurringJournalEntry {
  id              String    @id @default(uuid())
  name            String // e.g. "Monthly rent"
  frequency       String // WEEKLY | MONTHLY | QUARTERLY | YEARLY
  interval        Int       @default(1) // every N weeks/months/quarters/years
  startDate       DateTime
  nextDueDate     DateTime
  lastGeneratedAt DateTime?
  endDate         DateTime?
  status          String    @default("ACTIVE") // ACTIVE | PAUSED | CANCELLED
  notes           String?
  autoPost        Boolean   @default(false) // if true, generated entries post immediately
  // Snapshot of what to book (lines with accountId, debit/credit, tax, currency, fx)
  templateData    Json // { currency, description?, lines: [...] }
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Invoice {
  id              String    @id @default(uuid())
  invoiceNumber   String    @unique // INV-2026-0042 format
  contactId       String
  status          String // DRAFT, SENT, PAID, OVERDUE, CANCELLED
  currency        String    @default("EUR") // ISO 4217
  language        String    @default("en") // 'en' | 'de' for invoice text/labels
  subtotal        Decimal
  taxAmount       Decimal
  total           Decimal
  issueDate       DateTime
  dueDate         DateTime
  paidDate        DateTime?
  notes           String?
  terms           String?
  templateData    Json? // Layout customization (colors, fonts, logo position)
  paymentLink     String? // Stripe checkout or payment link
  stripeInvoiceId String? // If synced to Stripe
  paypalInvoiceId String? // If synced to PayPal
  journalEntryId        String? // Links to the revenue recognition journal entry created on invoice
  reversedJournalEntryId String? // Links to the reversing journal (credit note / cancellation) if any
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  contact      Contact       @relation(fields: [contactId], references: [id])
  lines        InvoiceLine[]
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Decimal @default(1)
  unitPrice   Decimal
  taxRateId   String?
  lineTotal   Decimal // quantity * unitPrice
  taxAmount   Decimal @default(0)

  invoice Invoice  @relation(fields: [invoiceId], references: [id])
  taxRate TaxRate? @relation(fields: [taxRateId], references: [id])
}

// Bank feed connections - links chart of accounts to external providers
model BankConnection {
  id          String    @id @default(uuid())
  accountId   String // Links to Chart of Accounts
  provider    String // 'stripe', 'paypal', or 'csv'
  externalId  String // Provider account/identifier
  credentials String? // Encrypted tokens/secrets (JSON blob encrypted)
  lastSyncAt  DateTime?
  syncEnabled Boolean   @default(true) // legacy compatibility; no scheduled synchronization
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  account          Account           @relation(fields: [accountId], references: [id])
  feedTransactions FeedTransaction[]

  @@index([provider])
}

// Raw feed transactions before matching to journal entries
model FeedTransaction {
  id             String   @id @default(uuid())
  connectionId   String // Links to BankConnection
  externalId     String // Provider's transaction ID
  date           DateTime
  description    String
  merchant       String? // Normalized merchant name
  amount         Decimal
  currency       String   @default("EUR")
  fxRateToBase   Decimal? // Rate at transaction time
  status         String   @default("pending") // 'pending', 'matched', 'posted', 'ignored'
  rawData        Json? // Original provider data for matching
  journalEntryId String? // Links to created journal entry
  createdAt      DateTime @default(now())

  connection   BankConnection @relation(fields: [connectionId], references: [id])
  journalEntry JournalEntry?  @relation(fields: [journalEntryId], references: [id])

  @@unique([connectionId, externalId])
  @@index([status])
  @@index([date])
}

// Memory Vault — persistent structured agent memory.
// The LLM (advisory path) can retrieve relevant items by key/scope.
// Authoritative facts (company profile, tax setup) are seeded by the system.
// Learned patterns and app knowledge can be added over time.
model AgentMemory {
  id        String   @id @default(uuid())
  key       String // e.g. "company.region", "merchant.acme.taxRate", "rule.always-bank-feed"
  value     Json // structured payload (can be string, object, array, etc.)
  scope     String // "company" | "merchant" | "user" | "global" | "tax" | "app" | ...
  category  String? // "fact" | "learned" | "preference" | "explanation" | ...
  source    String? // "system" | "ai" | "user"
  metadata  Json? // extra info (confidence, lastUsed, etc.)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, key])
  @@index([scope])
  @@index([key])
}

model ExpenseClaim {
  id                     String                          @id @default(uuid())
  claimNumber            String                          @unique
  claimantUserId         String
  title                  String
  purpose                String?
  workflowStatus         ExpenseClaimWorkflowStatus      @default(DRAFT)
  postingStatus          ExpenseClaimPostingStatus       @default(UNPOSTED)
  reimbursementStatus    ExpenseClaimReimbursementStatus @default(NOT_READY)
  revision               Int                             @default(1)
  approvedRevision       Int?
  baseCurrency           String                          @default("EUR")
  totalBaseAmount        Decimal                         @default(0)
  submittedAt            DateTime?
  approvedAt             DateTime?
  approvedByUserId       String?
  postedAt               DateTime?
  postedByUserId         String?
  postedJournalEntryId   String?                         @unique
  reimbursementAccountId String?
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt

  claimant             User                        @relation("ExpenseClaimClaimant", fields: [claimantUserId], references: [id], onDelete: Restrict)
  approvedBy           User?                       @relation("ExpenseClaimApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  postedBy             User?                       @relation("ExpenseClaimPoster", fields: [postedByUserId], references: [id], onDelete: Restrict)
  postedJournalEntry   JournalEntry?               @relation("ExpenseClaimPosting", fields: [postedJournalEntryId], references: [id], onDelete: Restrict)
  reimbursementAccount Account?                    @relation("ExpenseClaimReimbursementAccount", fields: [reimbursementAccountId], references: [id], onDelete: Restrict)
  lines                ExpenseClaimLine[]
  receipts             ExpenseClaimReceipt[]
  activities           ExpenseClaimActivity[]
  approvals            ExpenseClaimApproval[]
  reimbursements       ExpenseClaimReimbursement[]

  @@index([claimantUserId, workflowStatus])
  @@index([workflowStatus, postingStatus, reimbursementStatus])
  @@index([createdAt])
}

model ExpenseClaimLine {
  id            String                    @id @default(uuid())
  claimId       String
  position      Int
  expenseDate   DateTime
  merchant      String?
  description   String
  accountId     String
  grossAmount   Decimal
  netAmount     Decimal?
  taxAmount     Decimal?
  currency      String                    @default("EUR")
  fxRateToBase  Decimal?
  fxSource      String?
  fxDate        DateTime?
  baseAmount    Decimal
  taxRateId     String?
  taxIsInput    Boolean                   @default(true)
  paymentMethod ExpenseClaimPaymentMethod @default(PERSONAL_FUNDS)
  notes         String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  claim    ExpenseClaim              @relation(fields: [claimId], references: [id], onDelete: Cascade)
  account  Account                   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  taxRate  TaxRate?                  @relation(fields: [taxRateId], references: [id], onDelete: Restrict)
  receipts ExpenseClaimLineReceipt[]

  @@unique([claimId, position])
  @@index([accountId])
  @@index([expenseDate])
}

model ExpenseClaimReceipt {
  id               String   @id @default(uuid())
  claimId          String
  fileAssetId      String
  source           String   @default("manual")
  uploadedByUserId String
  extractionStatus String   @default("PENDING")
  extractedData    Json?
  duplicateStatus  String   @default("CLEAR")
  createdAt        DateTime @default(now())

  claim      ExpenseClaim              @relation(fields: [claimId], references: [id], onDelete: Cascade)
  fileAsset  FileAsset                 @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  uploadedBy User                      @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  lines      ExpenseClaimLineReceipt[]

  @@unique([claimId, fileAssetId])
  @@index([fileAssetId])
}

model ExpenseClaimLineReceipt {
  claimLineId    String
  claimReceiptId String

  line    ExpenseClaimLine    @relation(fields: [claimLineId], references: [id], onDelete: Cascade)
  receipt ExpenseClaimReceipt @relation(fields: [claimReceiptId], references: [id], onDelete: Cascade)

  @@id([claimLineId, claimReceiptId])
  @@index([claimReceiptId])
}

model ExpenseClaimApproval {
  id             String               @id @default(uuid())
  claimId        String
  revision       Int
  approverUserId String
  decision       ExpenseClaimDecision
  comment        String?
  createdAt      DateTime             @default(now())

  claim    ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  approver User         @relation(fields: [approverUserId], references: [id], onDelete: Restrict)

  @@index([claimId, revision])
}

model ExpenseClaimActivity {
  id          String   @id @default(uuid())
  claimId     String
  actorUserId String
  revision    Int
  action      String
  payload     Json?
  comment     String?
  createdAt   DateTime @default(now())

  claim ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  actor User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([claimId, createdAt])
}

model ExpenseClaimReimbursement {
  id              String   @id @default(uuid())
  claimId         String
  journalEntryId  String
  amount          Decimal
  currency        String
  paidAt          DateTime
  createdByUserId String
  createdAt       DateTime @default(now())

  claim        ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  createdBy    User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([claimId, paidAt])
}

model TotpRecoveryCode {
  id        String   @id @default(uuid())
  userId    String
  hash      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hash])
  @@index([userId])
}
