# Database
DATABASE_URL="postgresql://entrytwo:entrytwo_dev_password@localhost:5432/entrytwo"
DATABASE_URL_TEST="postgresql://entrytwo:entrytwo_dev_password@localhost:5432/entrytwo_test"
POSTGRES_PASSWORD=""

# Auth.js Configuration
# Generate separately with: openssl rand -hex 32 (at least 32 characters required)
AUTH_SECRET=""
# Public URL used in magic-link and invitation emails (and OAuth callbacks).
# Production: https://your.domain  |  Local: http://localhost:3000
AUTH_URL="http://localhost:3000"
# Production behind nginx/caddy/traefik: must be "true"
AUTH_TRUST_HOST="false"
# Lab-only: allow http AUTH_URL in production validation (never on the public internet)
AUTH_ALLOW_HTTP="false"

# Optional OAuth — Google and/or Microsoft Entra ID
# Register redirect URI: {AUTH_URL}/api/auth/callback/google
#                        {AUTH_URL}/api/auth/callback/microsoft-entra-id
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_ENTRA_ID_ID=""
MICROSOFT_ENTRA_ID_SECRET=""
MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"

# Durable worker authentication. Generate separately with: openssl rand -hex 32
JOB_RUNNER_SECRET=""
JOB_RUNNER_URL="http://127.0.0.1:3000"
JOB_RUNNER_INTERVAL_MS="5000"

# Email magic links + invitations (optional in local dev)
# When all three of HOST/USER/PASS are set, Auth.js email provider is enabled.
# In development you can still use instant email sign-in without SMTP.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@yourdomain.com"

# Encryption key for bank feed credentials (64 hex chars = 32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# Option 2: Resend API (recommended for cloud deployments)
# RESEND_API_KEY=""

# LLM Configuration
NEXT_LLM_PROVIDER="openai"
NEXT_LLM_MODEL="gpt-4o-mini"
NEXT_LLM_BASE_URL=""

# For xAI: NEXT_LLM_PROVIDER="xai", NEXT_LLM_MODEL="<model enabled in your xAI account>",
# and XAI_API_KEY. Leave NEXT_LLM_BASE_URL empty for the dedicated xAI provider.
# LLM API Keys (set one based on your provider; never share keys in agent output)
OPENAI_API_KEY=""
XAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""
DEEPSEEK_API_KEY=""
GOOGLE_API_KEY=""
KILOCODE_API_KEY=""
DASHSCOPE_API_KEY=""
HF_TOKEN=""
LM_API_KEY=""

# License activation (pay-to-own after the 30-day trial).
# Trial needs no key. After purchase, POST /api/license/activate calls this URL once.
# Leave unset and paid keys cannot activate (network verify required except the master key).
LICENSE_VERIFY_URL="https://entrytwo.com/api/license/verify"

# Payment/feed webhooks. Webhook endpoints fail closed unless configured.
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_BASE_URL="https://api-m.paypal.com"

# ---------------------------------------------------------------------------
# Self-hosted update delivery (see docs/Self-Hosted-Update-Delivery.md)
# The app applies updates by pulling a digest-pinned, cosign-signed image.
# UPDATER_SERVICE points at the compose service that runs the app; it needs
# the host Docker socket mounted (see compose.yaml).
# ---------------------------------------------------------------------------

# URL of the signed release manifest (raw manifest.json from the GitHub Release).
# Empty => the in-app "Update" page reports "not configured" and update is disabled.
UPDATE_MANIFEST_URL=""

# Set to "false" only to run unverified (not recommended). When omitted or any
# other value, the update is refused unless the image signature verifies.
UPDATE_VERIFY_SIGNATURE="true"

# Keyless verification (preferred): the cosign certificate identity regexp bound
# to our release workflow, e.g.
# "https://github.com/owner/entrytwo/.github/workflows/release.yml@refs/tags/v*"
COSIGN_IDENTITY=""

# OIDC issuer for keyless signing (default below is correct for GitHub Actions).
COSIGN_OIDC_ISSUER="https://token.actions.githubusercontent.com"

# Offline / air-gapped alternative: a pinned cosign public key (path or "kms:...").
# If set, it takes precedence over COSIGN_IDENTITY.
COSIGN_PUBLIC_KEY=""

# Extra args appended to `cosign verify` (advanced overrides).
COSIGN_VERIFY_ARGS=""

# Injected by compose.yaml (do not set by hand in most cases):
# APP_IMAGE, APP_VERSION, COMPOSE_FILE, UPDATE_SERVICE
APP_PUBLIC_URL="http://localhost:3000"

# Isolated updater sidecar (docs §6). When UPDATER_URL is set, the app delegates
# all Docker operations to this sidecar and never mounts the Docker socket, so a
# compromised app cannot modify itself. The sidecar must be reachable and must
# share UPDATER_TOKEN. Leave UPDATER_URL empty to fall back to in-app updates
# (requires the host Docker socket mounted into the app — not recommended).
UPDATER_URL="http://updater:4000"
# Shared secret between app and sidecar. MUST be identical here and in compose
# (the updater service defaults to the same value). Change before any real deploy.
UPDATER_TOKEN=""

# Attachment limits (bytes). Defaults: 25 MB/file, 20 files, 100 MB/batch.
MAX_ATTACHMENT_BYTES="26214400"
MAX_ATTACHMENTS_PER_UPLOAD="20"
MAX_ATTACHMENT_BATCH_BYTES="104857600"

# Portable backup limits and long transaction timeout.
BACKUP_MAX_IMPORT_BYTES="53687091200"
BACKUP_MAX_EXTRACTED_BYTES="107374182400"
BACKUP_TRANSACTION_TIMEOUT_MS="7200000"

# docker-compose service that runs the app (used by the sidecar).
UPDATE_SERVICE="app"
